{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fourth Watch shot plan contract v1",
  "type": "object",
  "required": ["schema_version","episode_id","fps","width","height","approved_script_sha256","approval","shots"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "episode_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,63}$"},
    "fps": {"type":"integer","minimum":1,"maximum":120},
    "width": {"type":"integer","minimum":360,"maximum":8192},
    "height": {"type":"integer","minimum":640,"maximum":8192},
    "approved_script_sha256": {"anyOf":[{"type":"null"},{"type":"string","pattern":"^[a-f0-9]{64}$"}]},
    "approval": {"type":"object","required":["script","treatment","animatic"],"properties":{"script":{"type":"boolean"},"treatment":{"type":"boolean"},"animatic":{"type":"boolean"}}},
    "shots": {"type":"array","minItems":1,"items":{"type":"object","required":["id","start_frame","end_frame","narration","read","medium","size","angle","camera","visual","claim_ids","beats"],"properties":{
       "id":{"type":"string","minLength":2},
       "start_frame":{"type":"integer","minimum":0},"end_frame":{"type":"integer","minimum":1},
       "narration":{"type":"string"},"read":{"type":"string","minLength":5},
       "medium":{"enum":["2d_character","2_5d_parallax","3d_object","motion_graphic","text_evidence"]},
       "size":{"enum":["XWS","WS","MS","MCU","CU","ECU"]},
       "angle":{"enum":["eye","high","low","top","ots","profile","dutch"]},
       "camera":{"type":"object","required":["move","why","start_scale","end_scale"],"properties":{"move":{"enum":["locked","push","pull","track","pan","crane","orbit","rack","whip"]},"why":{"type":"string"},"start_scale":{"type":"number","exclusiveMinimum":0},"end_scale":{"type":"number","exclusiveMinimum":0},"pan_x":{"type":"number"},"pan_y":{"type":"number"}}},
       "visual":{"type":"object","required":["setting","subject","action","key_light","mood","stage"],"properties":{"setting":{"type":"string"},"subject":{"type":"string"},"action":{"type":"string"},"key_light":{"type":"string"},"mood":{"type":"string"},"stage":{"enum":["PLACEHOLDER","DRAFT","FINAL"]},"motif":{"type":"string"},"palette":{"type":"string"}}},
       "claim_ids":{"type":"array","items":{"type":"string"}},
       "beats":{"type":"array","items":{"type":"object","required":["at_frame","kind","label"],"properties":{"at_frame":{"type":"integer"},"kind":{"enum":["reveal","action","reaction","visual_text","light","sound","cutaway"]},"label":{"type":"string"}}}},
       "transition_out":{"enum":["hard_cut","dissolve","match_shape","match_motion","camera_travel","graphic_morph","sound_bridge","dip_to_dark","smash_cut"]},
       "notes":{"type":"string"}
     }}}
  }
}
