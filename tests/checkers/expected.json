{
  "_about": "What each checker must report on each fixture. must_fail / must_not_fail are check names in the report's FAIL rows; exit is the process exit code; contains are substrings the report must include. Fixtures are built by make_fixtures.py. fixture: run another fixture's script file; args: extra checker arguments ({FX} = the fixtures folder).",
  "script": {
    "good": {
      "exit": 0,
      "must_not_fail": [
        "hook",
        "call to action",
        "fact-check",
        "reference",
        "verse",
        "answer",
        "value"
      ],
      "not_contains": [
        "never spoken",
        "repeated phrase",
        "signpost",
        "adds nothing new"
      ]
    },
    "bad_hook_mismatch": {
      "exit": 1,
      "must_fail": [
        "hook"
      ]
    },
    "bad_cta_in_vo": {
      "exit": 1,
      "must_fail": [
        "call to action"
      ]
    },
    "bad_pending_factcheck": {
      "exit": 1,
      "must_fail": [
        "fact-check"
      ]
    },
    "bad_no_reference": {
      "exit": 1,
      "must_fail": [
        "reference"
      ]
    },
    "bad_no_verse_card": {
      "exit": 1,
      "must_fail": [
        "verse"
      ]
    },
    "value_one_unspoken": {
      "exit": 1,
      "must_fail": [
        "value"
      ],
      "contains": [
        "never spoken"
      ]
    },
    "value_extra_unspoken": {
      "exit": 0,
      "contains": [
        "never spoken"
      ]
    },
    "repetition": {
      "exit": 0,
      "contains": [
        "repeated phrase",
        "slow to anger"
      ]
    },
    "signpost": {
      "exit": 0,
      "contains": [
        "signpost"
      ]
    },
    "dead_line": {
      "exit": 0,
      "contains": [
        "adds nothing new"
      ]
    },
    "answer_clause": {
      "exit": 1,
      "contains": [
        "| PASS | answer timing |"
      ]
    },
    "judge_pass": {
      "fixture": "good",
      "args": [
        "--judge",
        "{FX}/judge/pass"
      ],
      "exit": 0,
      "contains": [
        "| PASS | judge |"
      ]
    },
    "judge_notyet": {
      "fixture": "good",
      "args": [
        "--judge",
        "{FX}/judge/notyet"
      ],
      "exit": 1,
      "must_fail": [
        "judge"
      ]
    },
    "judge_stale": {
      "fixture": "good",
      "args": [
        "--judge",
        "{FX}/judge/stale"
      ],
      "exit": 1,
      "must_fail": [
        "judge"
      ],
      "contains": [
        "changed since"
      ]
    }
  },
  "video": {
    "_note": "8 s clips with no voice or captions, run with --no-asr, so runtime, captions and voice always FAIL; only the planted fault is asserted.",
    "v_good": {
      "must_not_fail": [
        "format",
        "motion",
        "loudness"
      ]
    },
    "v_wrong_size": {
      "must_fail": [
        "format"
      ],
      "must_not_fail": [
        "motion",
        "loudness"
      ]
    },
    "v_frozen": {
      "must_fail": [
        "motion"
      ],
      "must_not_fail": [
        "format",
        "loudness"
      ]
    },
    "v_too_loud": {
      "must_fail": [
        "loudness"
      ],
      "must_not_fail": [
        "format",
        "motion"
      ]
    }
  }
}
